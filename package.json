{
  "name": "justclaw",
  "version": "0.3.0",
  "description": "OpenClaw AI Agent Installer & Manager (Vue 3 + Electron)",
  "license": "MIT",
  "main": "./out/main/index.js",
  "author": "JustClaw",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron-winstaller",
      "electron"
    ]
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "generate-icons": "node scripts/generate-icon.cjs",
    "predev": "node scripts/generate-icon.cjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/generate-icon.cjs",
    "build": "vue-tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.node.json --composite false && vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:win": "pnpm build && electron-builder --win",
    "pack:mac": "pnpm build && electron-builder --mac",
    "pack:linux": "pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "plist": "^5.0.0",
    "unocss": "^66.7.5",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/plist": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
